rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/receipts/{allPaths=**} {
      // Allow read/write access to any authenticated user.
      allow read, write: if request.auth != null;
    }
    match /receipts/{tripId}/{allPaths=**} {
      // Allow read/write access to any authenticated user.
      allow read, write: if request.auth != null;
    }
  }
}
