rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{tripId}/{allPaths=**} {
      // Allow read/write access to any authenticated user.
      // In a production app, we would restrict this to members of the specific tripId,
      // but standard Storage rules cannot easily cross-reference Firestore without 
      // complex custom auth claims or Firebase rules v2 improvements.
      // For this app, as long as a user is authenticated, they can access the receipts.
      allow read, write: if request.auth != null;
    }
  }
}
