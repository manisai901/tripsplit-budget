rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTripMemberByDoc() {
      return isSignedIn() &&
        request.auth.uid in resource.data.members;
    }
    
    function isTripMemberById(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId));
      return isSignedIn() && trip != null && 'members' in trip.data && request.auth.uid in trip.data.members;
    }

    function isCreatingValidTrip() {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
    }

    function isJoiningSelf() {
      return isSignedIn()
        && resource.data.members is list
        && request.resource.data.members is list
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']);
    }

    match /trips/{tripId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if isCreatingValidTrip();
      allow update: if (request.auth != null && request.auth.uid in resource.data.members) || isJoiningSelf();
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /expenses/{expenseId} {
        allow read: if isTripMemberById(tripId);
        allow create, update, delete: if isTripMemberById(tripId);
      }
      
      match /checklist/{checklistId} {
        allow read: if isTripMemberById(tripId);
        allow create, update, delete: if isTripMemberById(tripId);
      }

      match /members/{memberId} {
        allow read: if isTripMemberById(tripId);
        allow create: if isTripMemberById(tripId) || (isSignedIn() && request.auth.uid == memberId);
        allow update, delete: if isTripMemberById(tripId);
      }

      match /settlements/{settlementId} {
        allow read: if isTripMemberById(tripId);
        allow create, update, delete: if isTripMemberById(tripId);
      }
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
